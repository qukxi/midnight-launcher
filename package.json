{
  "name": "midnight-launcher",
  "productName": "Midnight Launcher",
  "version": "0.2.0",
  "private": true,
  "description": "Midnight Launcher \u2014 desktop Minecraft Java launcher scaffold",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "build:mac": "tauri build --target aarch64-apple-darwin --bundles app && node scripts/package-macos.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  }
}
